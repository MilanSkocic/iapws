.TH iapws 3 "@DATE@" "@VERSION@" "Library Functions Manual"

.SH NAME
iapws \- library for light and heavy water properties according to IAPWS.

.SH LIBRARY
iapws library 
.RI ( libiapws ", " \-liapws )

.SH SYNOPSIS
\"{{{
.IP Fortran 10 
.B use iapws\fP

.IP C 10
.B #include \(dqiapws.h\(dq

.IP Python 10
.B import pyiapws
\"}}}

