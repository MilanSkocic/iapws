.TH iapws_pc 3 "@DATE@" "@VERSION@" "Library calls"

.SH NAME
pc \- critical pressure

.SH LIBRARY
iapws library 
.RI ( libiapws ", " \-liapws )

.SH SYNOPSIS
\"{{{
.IP Fortran 10
.BI "real(dp), parameter :: " pc_H2O

.BI "real(dp), parameter :: " pc_D2O

.IP C 10
.BI "const double " iapws_r283_pc_H2O;

.BI "const double " iapws_r283_pc_D2O;

.IP Python 10
.BI float: pc_H2O

.BI float: pc_D2O
\"}}}

.SH DESCRIPTION
Critical pressure constants for water, .\fBpc_H2O\fP, and heavy water, \fIpc_D2O\fP,
used for computing the water properties.

.SH EXAMPLES
.PP
Fortran
.nf
.ft CR
    use iapws
    real(dp) :: T = pc_H2O
    real(dp) :: T = pc_D2O
.ft R

.PP
C
.nf
.ft CR
    #include "iapws.h" 
    double T;
    T = iapws_r283_pc_H2O;
    T = iapws_r283_pc_D2O;
.ft R


.PP
Python: 
.nf
.ft CR 
    import pyiapws
    T = pc_H2O
    T = pc_D2O
.ft R
.fi


